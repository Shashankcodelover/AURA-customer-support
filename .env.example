# ─────────────────────────────────────────────────────────────
# OPTIONAL: Qwen API credentials
# ─────────────────────────────────────────────────────────────
# AURA runs completely out of the box WITHOUT these — it uses a
# built-in local reasoning engine (see lib/agents/classify.ts and
# lib/agents/investigate.ts) so the demo is 100% reliable even with
# no internet/API access during judging.
#
# Add a key here to let AURA call the real Qwen model for:
#   - Free-text intent/urgency/sentiment classification
#   - Root-cause narration in natural language
#   - Auto-drafted knowledge base articles (self-learning loop)
#
# Works with DashScope's OpenAI-compatible endpoint, or any other
# OpenAI-compatible Qwen provider (e.g. OpenRouter — just change
# QWEN_API_BASE_URL and QWEN_MODEL accordingly).

QWEN_API_KEY=
QWEN_API_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# Optional: only used by the "attach a screenshot" multimodal flow.
# Without this (or without QWEN_API_KEY), AURA honestly reports that visual
# analysis is unavailable instead of faking a result.
QWEN_VISION_MODEL=qwen-vl-plus
